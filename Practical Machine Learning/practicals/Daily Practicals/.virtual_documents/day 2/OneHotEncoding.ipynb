import numpy as np 
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import root_mean_squared_error ,mean_squared_error,r2_score   # use tab to get auto suggestion 
from sklearn.preprocessing import PolynomialFeatures, OneHotEncoder
import os
os.chdir('E:\Backup Files Abhinav_Satyam\Practical Machine Learning\Sanjay Sir Git Repo\Datasets')


df = pd.read_csv('Housing.csv')
df


 df.dtypes


x = df.drop('price', axis=1)
y = df['price']

encoder = OneHotEncoder(sparse_output = False, drop = 'first').set_output(transform = 'pandas')


num_cols = list(x.columns[x.dtypes == int])


str_cols = list(x.columns[x.dtypes != int])


x_num = x[num_cols]
x_str = x[str_cols]

x_ohe = encoder.fit_transform(x_str)
x_enc = pd.concat([x_ohe,x_num], axis = 1)


x_enc


x_train , x_test, y_train, y_test = train_test_split(x_enc, y , test_size = 0.3, random_state = 26)


lr = LinearRegression()
lr.fit(x_train, y_train)


res = lr.predict(x_test)


root_mean_squared_error(y_test, res)


r2_score(y_test, res)





# ==================================



poly = PolynomialFeatures(degree = 2,include_bias = False).set_output(transform = 'pandas')
x_poly =poly.fit_transform(x_enc)
x_train , X_test, y_train, y_test = train_test_split(x_poly, y, random_state = 26, test_size = 0.3)

lr = LinearRegression()
lr.fit(x_train, y_train)
y_pred = lr.predict(X_test)


root_mean_squared_error(y_test, y_pred)



poly = PolynomialFeatures(degree = 1,include_bias = False).set_output(transform = 'pandas')
x_poly =poly.fit_transform(x_enc)
x_train , X_test, y_train, y_test = train_test_split(x_poly, y, random_state = 26, test_size = 0.3)

lr = LinearRegression()
lr.fit(x_train, y_train)
y_pred = lr.predict(X_test)


root_mean_squared_error(y_test, y_pred)



