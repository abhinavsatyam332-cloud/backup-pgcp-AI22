import pandas as pd
import numpy as np 

import matplotlib.pyplot as plt

from sklearn.ensemble import RandomForestClassifier, RandomForestRegressor


from sklearn.model_selection import train_test_split
import warnings
warnings.filterwarnings("ignore")

from sklearn.metrics import accuracy_score, recall_score, precision_score, f1_score, classification_report
from sklearn.metrics import confusion_matrix,ConfusionMatrixDisplay



bcancer = pd.read_csv('BreastCancer.csv',index_col=0)
bcancer


X,y = bcancer.drop('Class', axis = 1) , bcancer['Class']

X_train, X_test, y_train, y_test = train_test_split(X,y, test_size = 0.3, random_state=26, stratify=y)


m_feat = [2,3,4,5]
n_samples = [25,50,100]
scores = []
for m in m_feat:
    for n in n_samples:
        rf = RandomForestClassifier(max_features=m, n_estimators=n,random_state=26)

        rf.fit(X_train, y_train)
        y_pred = rf.predict(X_test)
        scores.append([m, n , f1_score(y_test, y_pred, average='macro')])

df_scores = pd.DataFrame(scores, columns=['Features','n','f1_score'])
df_scores.sort_values(by='f1_score',ascending=False)


