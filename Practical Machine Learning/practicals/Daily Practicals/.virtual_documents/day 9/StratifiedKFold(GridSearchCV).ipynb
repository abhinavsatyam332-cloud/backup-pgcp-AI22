import os
import pandas as pd
import numpy as np 
import matplotlib.pyplot as plt
import seaborn as sns

 
from sklearn.metrics import confusion_matrix , roc_curve, RocCurveDisplay, roc_auc_score 

from sklearn.ensemble import GradientBoostingClassifier   

from sklearn.preprocessing import  LabelEncoder 
 

from sklearn.model_selection import KFold ,cross_val_score, cross_val_predict, StratifiedKFold
from tqdm import tqdm 
from sklearn.linear_model import LogisticRegression


import warnings
warnings.filterwarnings("ignore")

os.chdir(r"C:\Users\RAJESH\Desktop\ss\Datasets\Cases\Vehicle Silhouettes")


vehicle = pd.read_csv("Vehicle.csv")
X , y = vehicle.drop('Class' , axis = 1) , vehicle['Class']

le  = LabelEncoder()

le_y = le.fit_transform(y)

kfold = StratifiedKFold(n_splits=5 , shuffle=True , random_state=26)
gbm = GradientBoostingClassifier(random_state=26)


 


# Accuracy Score:

results = cross_val_score(gbm , X , le_y , cv = kfold)
results


np.mean(results)





learning_rates = np.linspace(0.01,0.9,10)
max_depths = [None,2,3,4]
n_estimator = [25,50,100] 
scores = []
for d in tqdm(max_depths):
      for e in n_estimator:
          for r in learning_rates:
                gbm = GradientBoostingClassifier(random_state=26,n_estimators=e,max_depth=d,learning_rate=r)
              
                results = cross_val_score(gbm , X , le_y , cv = kfold, scoring='neg_log_loss')
                
              
                scores.append([d,e,r,np.mean(results)])

              
df_scores = pd.DataFrame(scores, columns=['depth','estimator','learning_rate','cross_val_score mean'])


df_scores.sort_values('cross_val_score mean', ascending=False)





solvers = ['lbfgs','newton-cg','newton-cholesky']
scores = []
for s in tqdm(solvers):
    lr = LogisticRegression(solver=s)
    results = cross_val_score(lr,X, le_y, cv=kfold, scoring='neg_log_loss')
    scores.append([s,np.mean(results)])
df_scores = pd.DataFrame(scores, columns=['solver','score'])
df_scores.sort_values('score', ascending=False)


kfold = StratifiedKFold(n_splits=5 , shuffle=True , random_state=26)
solvers = ['lbfgs','newton-cg','newton-cholesky']
Cs = np.linspace(0.01,3,5)
scores = []
for s in tqdm(solvers):
    for c in Cs:
        lr = LogisticRegression(solver=s, C=c)
        results = cross_val_score(lr,X, le_y, cv=kfold, scoring='neg_log_loss')
        scores.append([s,c,np.mean(results)])
df_scores = pd.DataFrame(scores, columns=['solver','C','score'])
df_scores.sort_values('score', ascending=False)


# best
df_scores.sort_values('score', ascending=False).iloc[0]




















from sklearn.model_selection import GridSearchCV




lr = LogisticRegression()

solvers = ['lbfgs','newton-cg','newton-cholesky']
Cs = np.linspace(0.01,3,5)

params = {
    'solver': ['lbfgs','newton-cg','newton-cholesky'],
    'C' : np.linspace(0.01,3,5)
}

gcv = GridSearchCV(lr,param_grid = params , cv = kfold , scoring = 'neg_log_loss')

gcv.fit(X, le_y)


gcv.best_params_


gcv.best_score_



