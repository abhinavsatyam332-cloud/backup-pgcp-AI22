# ===================   all laso ridge , elastic       ==============================


df = pd.read_csv('Exp_salaries.csv')

x = df.drop('Salary', axis=1)
y = df['Salary']

# drop deleting columns by alphabetical order means Gender_Female, Department_A
encoder = OneHotEncoder(sparse_output = False, drop = 'first').set_output(transform = 'pandas')
num_cols = list(x.columns[x.dtypes == int])
str_cols = list(x.columns[x.dtypes != int])

x_num = x[num_cols]
x_str = x[str_cols]

x_ohe = encoder.fit_transform(x_str)
x_enc = pd.concat([x_ohe,x_num], axis = 1)
x_train , x_test, y_train, y_test = train_test_split(x_enc, y , test_size = 0.3, random_state = 26)
x_ohe


alphas = np.linspace(0.001, 10.0,20) 

lst = []

for alp in alphas:
    ridg = Ridge(alpha=alp)
    ridg.fit(x_train, y_train)
    y_pred = ridg.predict(x_test)
    lst.append([alp,r2_score(y_test, y_pred)]) 

valsdic = pd.DataFrame(lst, columns = ['alpha','ridge r2 score'])
valsdic.sort_values('ridge r2 score',ascending = False)



valsdic = pd.DataFrame(index = alphas)

lst = []
for alp in alphas:
    lasso = Lasso(alpha=alp)
    lasso.fit(x_train, y_train)
    y_pred = lasso.predict(x_test)
    lst.append([alp,r2_score(y_test, y_pred)]) 

valsdic = pd.DataFrame(lst,columns = ['alpha','lasso r2 score'])
valsdic.sort_values('lasso r2 score',ascending = False)



l1_ratios = np.linspace(0.001,1,20)
scores = []
for alp in alphas:
    for r in l1_ratios:
        elnet = ElasticNet(alpha=alp, l1_ratio = r)
        elnet.fit(x_train, y_train)
        y_pred = elnet.predict(x_test)
        scores.append([alp,r,r2_score(y_test, y_pred)])

 

# 2. Convert the list of results into a DataFrame
df_scores = pd.DataFrame(scores, columns=['alpha', 'l1_ratio', 'r2_score'])
df_scores.sort_values('r2_score',ascending = False)
 









