import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from scipy.cluster.hierarchy import linkage, dendrogram

from sklearn.preprocessing import StandardScaler
import os
os.chdir(r'E:\Backup Files Abhinav_Satyam\Practical Machine Learning\Sanjay Sir Git Repo\Datasets')


df = pd.read_csv('simp_clust.csv', index_col = 0)
df





sns.scatterplot(x = 'X1', y = 'X2',data = df)
for i in range(df.shape[0]):
    plt.text(x = df['X1'].values[i] , 
             y = df['X2'].values[i], 
             s = list(df.index)[i] ,
             fontsize=12)
plt.show()


scaler = StandardScaler().set_output(transform='pandas')
df_scaled = scaler.fit_transform(df)
link = 'average'
mergings = linkage(df_scaled , method=link)
dendrogram(mergings, labels=list(df_scaled.index))
plt.title('Hierarchical Clustering Dendrogram   link:'+link)
plt.xlabel('Data Points / Items')
plt.ylabel('Euclidean Distance')
plt.show()


links = ['single','complete','average','ward','centroid']
for l in links:
    scaler = StandardScaler().set_output(transform='pandas')
    df_scaled = scaler.fit_transform(df)
    link = l
    mergings = linkage(df_scaled , method=link)
    dendrogram(mergings, labels=list(df_scaled.index))
    plt.title('linkage: '+link+' \n Hierarchical Clustering Dendrogram ')
    plt.xlabel('Data Points / Items')
    plt.ylabel('Euclidean Distance') 
    plt.show()


















