import pandas as pd
import numpy as np
from tqdm import tqdm
from sentence_transformers import SentenceTransformer


df = pd.read_csv('titles.csv')
df.shape
df.columns


df


df_indian_movies = df[(df['production_countries'].str.contains('IN')) & (df['type']=='MOVIE')]
df_indian_movies



model = SentenceTransformer('BAAI/bge-small-en-v1.5')


model.encode("I am feeling gfvf g DFgood").shape   # for any text gives same 384 embeddings


all_desc = list(df_indian_movies['description'])

out_embs = []  # this are vector embeddings which are generally stored in vector Databases like pinecone , Qdrant

for i in tqdm(all_desc):
  enmd = model.encode(i)
  out_embs.append(enmd)
out_embs = np.array(out_embs)





df_indian_movies['movieID'] = df_indian_movies['id'] + '-' + df_indian_movies['title']
df_embd = pd.DataFrame(out_embs , index=list(df_indian_movies['movieID']))
df_embd








from sklearn.cluster import HDBSCAN
from sklearn.metrics import silhouette_score


hdbscan = HDBSCAN(min_cluster_size=2 )
hdbscan.fit(out_embs)
df_embd['hdbscan_cluster'] = hdbscan.labels_
df_embd['hdbscan_cluster'].value_counts()





df_embd[df_embd['hdbscan_cluster']==5]


df_indian_movies[(df_embd['hdbscan_cluster'] == 48).values][['title' , 'description']]









